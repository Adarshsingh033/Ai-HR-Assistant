# =============================================================================
# AI HR Assistant – Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit your .env file to version control.
# =============================================================================

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_NAME=hrms
DB_USER=postgres
DB_PASSWORD=adarsh123
DB_HOST=localhost
DB_PORT=5432

# ── Application ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Default Admin (seeded on first startup) ──────────────────────────────────
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ── Super Admin (seeded on first startup) ────────────────────────────────────
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=superadmin123
SUPER_ADMIN_FULL_NAME="Super Administrator"

# ── AI / LLM (Ollama & Groq) ──────────────────────────────────────────────────
OLLAMA_MODEL=gemma2:9b
GROQ_API_KEY=
GROQ_MODEL=compound-beta-mini

# ── SMTP Email (Optional – leave blank to simulate locally) ──────────────────
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
