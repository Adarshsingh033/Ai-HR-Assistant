# Base URL of the FastAPI Backend
API_BASE_URL=http://localhost:8000

# Backend Host & Port settings
BACKEND_HOST=localhost
BACKEND_PORT=8000

# Application Title & Metadata
APP_NAME=AI HR Assistant
APP_VERSION=1.0.0
